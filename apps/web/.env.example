# No environment variables required for basic operation.
# FFmpeg WASM files are copied from node_modules to public/ffmpeg/ automatically
# via the prebuild/predev script. MKV playback requires these files.

# ── Feature flags (Unleash) ────────────────────────────────────────────────────
# Unleash Frontend API URL, e.g. https://your-instance.unleash-hosted.com/api/frontend
NEXT_PUBLIC_UNLEASH_URL=
# Unleash Frontend token (create one under Configure → API Access, type: Frontend)
NEXT_PUBLIC_UNLEASH_CLIENT_KEY=

# ── Online subtitle search (OpenSubtitles) ────────────────────────────────────
# Server-side only — never prefix these with NEXT_PUBLIC_. Without the API key
# the /api/subtitles routes return 404 and the player hides the search UI.
# Get a key at https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
# Optional. OpenSubtitles requires a descriptive, versioned User-Agent.
OPENSUBTITLES_USER_AGENT="LightBird v1.0"
