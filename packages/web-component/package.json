{
  "name": "@lightbird/player",
  "version": "0.11.0",
  "description": "Framework-agnostic <lightbird-player> Web Component. Drop-in video player for Vue, Svelte, Angular, Solid, or plain HTML — powered by @lightbird/core.",
  "license": "MIT",
  "author": "Punyam Singh",
  "homepage": "https://lightbird.vercel.app/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/punyamsingh/lightbird",
    "directory": "packages/web-component"
  },
  "keywords": [
    "video",
    "player",
    "web-component",
    "custom-element",
    "lightbird",
    "vue",
    "svelte",
    "mkv",
    "hls"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@lightbird/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-jest-mock-import-meta": "^1.3.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
